# Copy to .env — use the same values as sakura-mobile/.env.
# EXPO_PUBLIC_* vars are embedded in the client bundle at `npm run build` time.

EXPO_PUBLIC_SUPABASE_URL=https://aofzomovaozcwcozokll.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required on web — public Solana RPC blocks browser requests (403).
EXPO_PUBLIC_HELIUS_API_KEY=your_helius_key

EXPO_PUBLIC_AVATAR_PAYMENT_WALLET=G8tc69u9PVjAjaL4h8iD3t845dJrvnTKusrLrjv89EZ1
EXPO_PUBLIC_AVATAR_MINT_PRICE_SAKURA=100000

# Optional: override the bundled Jupiter key for buying SKR with SOL (https://portal.jup.ag)
# EXPO_PUBLIC_JUPITER_API_KEY=your_jupiter_api_key

# Transak fiat on-ramp for buying SOL with card (https://dashboard.transak.com)
EXPO_PUBLIC_TRANSAK_API_KEY=your_transak_api_key

# Server-only avatar mint secrets (set in Supabase, not in this client env):
# BFL_API_KEY, AVATAR_MINT_AUTHORITY_SECRET, SUPABASE_SERVICE_ROLE_KEY,
# and SOLANA_RPC or HELIUS_API_KEY for reliable payment verification/minting.

EXPO_PUBLIC_COMICS_PROXY=http://165.232.83.159/comics/v1
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUBLIC_GIPHY_API_KEY=your_giphy_api_key
