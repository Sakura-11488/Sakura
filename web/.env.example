# Expo Web build env. Start from sakura-mobile/.env.example (single source of
# truth for the shared EXPO_PUBLIC_* vars) — this file lists only what differs
# on web. EXPO_PUBLIC_* vars are embedded in the bundle at `npm run build`.

# Same values as sakura-mobile/.env:
EXPO_PUBLIC_SUPABASE_URL=https://aofzomovaozcwcozokll.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# REQUIRED on web (optional on mobile) — public Solana RPC blocks browser
# requests with 403, so a Helius key is not optional here.
EXPO_PUBLIC_HELIUS_API_KEY=your_helius_key

# Jupiter swap key — required for SOL→SKR swaps (https://portal.jup.ag)
EXPO_PUBLIC_JUPITER_API_KEY=your_jupiter_api_key

# All other vars (avatar mint, comics/consumet proxies, Transak, Giphy,
# Phoenix, push, mints-verify) are documented in sakura-mobile/.env.example
# and behave identically on web. Edge-function secrets:
# sakura-mobile/supabase/edge-functions.env.example
