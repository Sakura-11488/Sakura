{
    "name": "sakura-hentai-scraper",
    "version": "1.1.0",
    "private": true,
    "description": "HTML scraper proxy that powers the Sakura 18+ tab. Runs on the DigitalOcean droplet behind nginx at /hentai/v1/*.",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js"
    },
    "dependencies": {
        "cheerio": "1.0.0",
        "express": "4.21.2",
        "impit": "0.14.3",
        "lru-cache": "11.0.2",
        "undici": "7.2.0"
    },
    "engines": {
        "node": ">=20"
    }
}
