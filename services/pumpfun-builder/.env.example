# The builder holds mint keys. Every value here is a secret except PORT.

PORT=8080

# Supabase, for the vanity_mints pool. Service role: the table has no anon policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# base64 of 32 random bytes. Must match the key the grinder encrypted with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Supabase stores only ciphertext, so this key is what makes a database read
# useless on its own. It must not be stored in Supabase.
VANITY_MINT_ENCRYPTION_KEY=

# Shared with the creator-coin-launch edge function. At least 32 chars.
# Without it, anyone who finds this URL can drain the pool one reservation at a
# time — a denial of service on something that costs hours of grinding.
BUILDER_AUTH_SECRET=

# A real RPC. Contains an api-key; it is redacted before logging.
SOLANA_RPC=

# Optional
PRIORITY_FEE_MICRO_LAMPORTS=0
METADATA_TIMEOUT_MS=6000
