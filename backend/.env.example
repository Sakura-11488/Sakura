# Solana RPC (use a paid provider for websocket support — Helius, Triton, QuickNode)
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Server trading wallet private key (base58-encoded)
# This wallet needs funded SOL for Drift collateral and tx fees
DRIFT_WALLET_KEY=your_base58_private_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# SAKURA token config (shared with frontend)
SAKURA_MINT=EWiVNxCqNatzV2paBHyfKUwGLnk7WKs9uZTA5jkTpump
SAKURA_TREASURY_ADMIN=5NcWtvtQ48QJcizEs9i8H7Ef3YmtmybnSkPQxA2fxFiF

# Server port
