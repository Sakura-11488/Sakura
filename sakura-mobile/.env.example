# Copy to .env and fill in values from the Sakura Supabase project dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://aofzomovaozcwcozokll.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Avatar NFT mint (100k SAKURA to treasury wallet)
EXPO_PUBLIC_AVATAR_PAYMENT_WALLET=G8tc69u9PVjAjaL4h8iD3t845dJrvnTKusrLrjv89EZ1
EXPO_PUBLIC_AVATAR_MINT_PRICE_SAKURA=100000

# Optional: override the bundled Jupiter key for buying SKR with SOL (https://portal.jup.ag)
# EXPO_PUBLIC_JUPITER_API_KEY=your_jupiter_api_key

# Server-only (set via: supabase secrets set NAME=value)
# BFL_API_KEY is required for anime avatar generation Edge Function.
# AVATAR_MINT_AUTHORITY_SECRET is required for on-chain NFT minting.
# SUPABASE_SERVICE_ROLE_KEY is required by the avatar Edge Function.
# SOLANA_RPC or HELIUS_API_KEY is recommended for reliable payment verification and minting.

# RPC: leave EXPO_PUBLIC_SOLANA_RPC unset to use Helius mainnet when EXPO_PUBLIC_HELIUS_API_KEY is set.
# EXPO_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Optional — faster, more reliable mainnet reads (recommended on device builds)
# EXPO_PUBLIC_HELIUS_API_KEY=your_helius_key
EXPO_PUBLIC_EAS_PROJECT_ID=13100d7d-c96a-469e-8de7-90c664502b9f
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false

# Giphy — chat GIF/sticker picker (https://developers.giphy.com/)
EXPO_PUBLIC_GIPHY_API_KEY=your_giphy_api_key

# ── Content sources (defaults point at the droplet; see lib/content-hosts.ts) ──
# Each scraper has its own override. Pointing two sources at one base makes the
# wrong scraper answer — it will happily serve /popular and /search for content
# it doesn't have, with no error.
# EXPO_PUBLIC_COMICS_PROXY=http://165.232.83.159/comics/v1
# EXPO_PUBLIC_MANHWA_PROXY=http://165.232.83.159/manhwa/v1
# EXPO_PUBLIC_CONSUMET_URL=http://165-232-83-159.nip.io:3000
# Media ingest API (creator video uploads) — defaults to <media host>/media/v1
# EXPO_PUBLIC_MEDIA_INGEST_BASE=http://165-232-83-159.nip.io/media/v1

# Transak fiat on-ramp for buying SOL with card (https://dashboard.transak.com)
# EXPO_PUBLIC_TRANSAK_API_KEY=your_transak_api_key

# Creator-work NFT mint verification endpoint — creator mint flow is inert if unset
# EXPO_PUBLIC_MINTS_VERIFY_URL=

# Phoenix DEX (trading UI)
# EXPO_PUBLIC_PHOENIX_API_URL=
# EXPO_PUBLIC_PHOENIX_DEFAULT_MARKET=
# EXPO_PUBLIC_PHOENIX_PROGRAM_ID=

# Edge-function secrets are documented in supabase/edge-functions.env.example
