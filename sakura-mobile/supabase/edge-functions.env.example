# Sakura Edge Function secrets — set via `supabase secrets set NAME=value`
# (never commit real values). Grouped by function area. Project: aofzomovaozcwcozokll
#
# Injected automatically by Supabase (do not set manually):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET

# ── Solana RPC (payment verification, minting) ──
# One of these is strongly recommended; falls back to public mainnet RPC.
SOLANA_RPC=
# SOLANA_RPC_URL=            # legacy alias read by some functions
# HELIUS_API_KEY=            # builds a Helius RPC URL when SOLANA_RPC unset
# EXPO_PUBLIC_SOLANA_RPC=    # legacy alias
# EXPO_PUBLIC_SOLANA_RPC_URL=# legacy alias
# EXPO_PUBLIC_HELIUS_API_KEY=# legacy alias

# ── $SAKURA token ──
# SAKURA_MINT=EWiVNxCqNatzV2paBHyfKUwGLnk7WKs9uZTA5jkTpump

# ── Avatar NFT generation + mint (generate-user-avatar) ──
BFL_API_KEY=                  # Black Forest Labs — image generation (required)
AVATAR_MINT_AUTHORITY_SECRET= # keypair secret for on-chain mint (required)
# AVATAR_COLLECTION_MINT=
# AVATAR_PAYMENT_WALLET=G8tc69u9PVjAjaL4h8iD3t845dJrvnTKusrLrjv89EZ1
# AVATAR_MINT_PRICE_SAKURA=100000
# AVATAR_RATE_LIMIT_HOURS=
# AVATAR_ADMIN_TEST_SECRET=   # test-only bypass; leave unset in prod
# FLUX_PROVIDER=              # bfl | fal
# BFL_FLUX_MODEL=
# FAL_KEY=
# FAL_FLUX_MODEL=

# ── Sakura AI chat (sakura-ai-chat — lives in Sakura/supabase/functions/) ──
GROQ_API_KEY=
# SAKURA_AI_MODEL=
# SAKURA_AI_FALLBACK_MODELS=
# SAKURA_AI_MAX_MESSAGES=
# SAKURA_AI_RATE_LIMIT_PER_MINUTE=

# ── Push notifications ──
# EXPO_ACCESS_TOKEN=          # Expo push API auth
# PUSH_SEND_SECRET=           # shared secret for cron-triggered push functions

# ── Content proxies (defaults point at the droplet — lib/content-hosts.ts) ──
# SAKURA_MEDIA_BASE=http://165-232-83-159.nip.io
# COMICS_PROXY_BASE=http://165.232.83.159/comics/v1
# HENTAI_PROXY_BASE=http://165.232.83.159/hentai/v1
# CONSUMET_URL=http://165-232-83-159.nip.io:3000

# ── Coin launch ──
# PUMPFUN_UNSIGNED_TX_URL=

# -- Realtime chat --
# Project JWT secret (Dashboard > Project Settings > API > JWT Secret).
# Required for wallet-realtime-session to mint socket tokens; without it
# realtime chat silently falls back to polling.
# REALTIME_JWT_SECRET=
