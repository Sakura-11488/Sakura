# Transak fiat on-ramp API key (get from https://dashboard.transak.com)
NEXT_PUBLIC_TRANSAK_API_KEY=your_key_here

# Consumet API URL for anime streaming (required)
# Deploy your own free on Vercel in 1 click:
# 1. Go to https://github.com/consumet/api.consumet.org
# 2. Click "Deploy with Vercel" button in the README
# 3. Paste the URL below (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_CONSUMET_URL=https://your-consumet-instance.vercel.app

# Anime provider (optional, default: gogoanime)
# Options: gogoanime, animepahe, zoro
# NEXT_PUBLIC_ANIME_PROVIDER=gogoanime

# Perps backend API URL (required for trading)
NEXT_PUBLIC_PERPS_API_URL=http://localhost:4000/api
