# Legacy Next.js app env — copy to .env.local at the repo root and fill in.
# NEXT_PUBLIC_* vars are embedded in the client bundle at build time.

# ── Supabase (project aofzomovaozcwcozokll — same as sakura-mobile) ──
NEXT_PUBLIC_SUPABASE_URL=https://aofzomovaozcwcozokll.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side only (API routes) — never expose to the client:
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ── Solana ──
# Helius RPC — recommended; falls back to public mainnet RPC
# NEXT_PUBLIC_HELIUS_API_KEY=your_helius_key
# Jupiter swap API — free key from https://portal.jup.ag (required for swaps)
NEXT_PUBLIC_JUPITER_API_KEY=
# NEXT_PUBLIC_ADMIN_WALLET=
# NEXT_PUBLIC_MAYAN_API_KEY=

# ── Content sources (defaults point at the droplet; see
#    sakura-mobile/lib/content-hosts.ts) ──
# NEXT_PUBLIC_COMICS_PROXY=http://165.232.83.159/comics/v1
# NEXT_PUBLIC_CONSUMET_URL=http://165-232-83-159.nip.io:3000

# ── Trading (Phoenix DEX / perps backend) ──
# NEXT_PUBLIC_PHOENIX_API_URL=
# NEXT_PUBLIC_PHOENIX_WS_URL=
# NEXT_PUBLIC_PHOENIX_DEFAULT_MARKET=
# NEXT_PUBLIC_PHOENIX_REFERRAL_CODE=
# NEXT_PUBLIC_PERPS_API_URL=

# ── Misc ──
# NEXT_PUBLIC_SAKURA_AI_PROXY_URL=
# NEXT_PUBLIC_SAKURA_SHARE_BASE=
# NEXT_PUBLIC_APP_UPDATE_SOURCE=
# NEXT_PUBLIC_APP_UPDATE_URL=
# NEXT_PUBLIC_GITHUB_REPO=
