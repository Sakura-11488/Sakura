/node_modules
# Anchored rules only cover the root, so every nested package needs its own.
# A junctioned node_modules under services/ made `git add -A` walk the whole
# linked tree before this was added.
services/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!.env.example
!**/.env.example
.build-tools/
.gh-tools/
.release-excluded-assets/
degenchronicles/*.MOV
degenchronicles/*.mp4
degenchronicles/*.zip
degenchronicles/icons/
degenchronicles/server/2heanime/incoming/
degenchronicles/server/2heanime/videos/
# Episode binaries — host on server/CDN; never commit (654MB+ breaks git push)
degenchronicles/server/degegen-files/episodes/
degenchronicles/server/**/*.mp4
degenchronicles/server/**/*.mov
degenchronicles/server/**/*.MOV

.vercel
*.tsbuildinfo
next-env.d.ts
/Weekly Viz*/
